#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// 定義層級名稱（Layer Names）
#define MAC       0
#define WIN       1
#define NUM       2
#define SYM       3
#define WIN_SYM   4
#define NAV       5
#define MOUSE     6
#define WIN_MOUSE 7
#define TMUX      8
#define SYS       9

/ {
    chosen {
        zmk,matrix_transform = &default_transform;
        // zmk,matrix_transform = &five_column_transform;
    };

    // 條件層：同時按住 NUM + SYM (或 WIN_SYM) 時自動開啟 SYS 層
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer_mac {
            if-layers = <NUM SYM>;
            then-layer = <SYS>;
        };
        tri_layer_win {
            if-layers = <NUM WIN_SYM>;
            then-layer = <SYS>;
        };
    };

    macros {
        tmux_cmd: tmux_cmd {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>; // 右半部所有鍵位索引
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>; // 左半部所有鍵位索引
            hold-trigger-on-release;
        };

        smart_caps: smart_caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BSPC DELETE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J + K -> ESC (位置 19 + 20)
        combo_esc {
            timeout-ms = <40>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };

        // F + D -> Backspace (位置 16 + 15)
        combo_bspc {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&kp BSPC>;
        };

        // C + V -> Homerow Mac App (位置 27 + 28)
        combo_homerow {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp LS(LG(SPACE))>;
        };

        // D + K -> Caps Word (位置 15 + 20)
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <15 20>;
            bindings = <&smart_caps>;
        };

        // U + I -> 等號 = (位置 7 + 8)
        combo_equal {
            timeout-ms = <40>;
            key-positions = <7 8>;
            bindings = <&kp EQUAL>;
        };

        // M + COMMA -> 減號 - (位置 31 + 32)
        combo_minus {
            timeout-ms = <40>;
            key-positions = <31 32>;
            bindings = <&kp MINUS>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Mac 預設層
        default_layer {
            label = "MAC";
            bindings = <
    &tog WIN  &kp Q        &kp W        &kp E        &kp R        &kp T     &kp Y   &kp U        &kp I        &kp O        &kp P           &none    
    &none     &hml LCTRL A &hml LALT S  &hml LCMD D  &hml LSHFT F &kp G     &kp H   &hmr RSHFT J &hmr RCMD K  &hmr RALT L  &hmr RCTRL SEMI &none    
    &none     &kp Z        &kp X        &kp C        &kp V        &kp B     &kp N   &kp M        &kp COMMA    &kp DOT      &kp FSLH        &none    
                                        &lt NUM CAPS &lt SYM TAB  &kp SPACE &kp RET &lt NAV BACKSPACE         &lt MOUSE ESC   
            >;
        };

        // Layer 1: Windows 預設層
        win_layer {
            label = "WIN";
            bindings = <
    &tog WIN  &kp Q        &kp W        &kp E        &kp R        &kp T     &kp Y   &kp U        &kp I        &kp O        &kp P           &none    
    &none     &hml LGUI A  &hml LALT S  &hml LCTRL D &hml LSHFT F &kp G     &kp H   &hmr RSHFT J &hmr RCTRL K &hmr RALT L  &hmr RGUI SEMI  &none    
    &none     &kp Z        &kp X        &kp C        &kp V        &kp B     &kp N   &kp M        &kp COMMA    &kp DOT      &kp FSLH        &none    
                                        &lt NUM CAPS &lt WIN_SYM TAB &kp SPACE &kp RET &lt NAV BACKSPACE      &lt WIN_MOUSE ESC   
            >;
        };

        // Layer 2: 數字層
        num_layer {
            label = "NUMBER";
            bindings = <
    &none  &kp N1  &kp N2  &kp N3  &kp N4   &kp N5   &kp N6        &kp N7  &kp N8  &kp N9  &kp N0  &none     
    &none  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &none         &kp N4  &kp N5  &kp N6  &none   &none     
    &none  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &none         &none   &kp N1  &kp N2  &kp N3  &none
                           &trans  &kp F11  &kp F12  &kp DEL       &kp N0  &none  
            >;
        };

        // Layer 3: Mac 符號與快捷鍵層
        symbol_layer {
            label = "SYMBOL";
            bindings = <
    &none  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET  &kp AMPS   &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &none
    &none  &kp TILDE &kp GRAVE &trans    &trans    &trans      &kp BSLH   &kp MINUS  &kp EQUAL       &kp LBKT  &kp RBKT  &none
    &none  &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(Y)   &kp PIPE   &kp UNDER  &kp PLUS        &kp LBRC  &kp RBRC  &none
                               &none     &trans    &none       &kp BSPC   &kp DQT    &kp SQT
            >;
        };

        // Layer 4: Windows 符號與快捷鍵層
        win_symbol_layer {
            label = "WIN_SYM";
            bindings = <
    &none  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET  &kp AMPS   &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &none
    &none  &kp TILDE &kp GRAVE &trans    &trans    &trans      &kp BSLH   &kp MINUS  &kp EQUAL       &kp LBKT  &kp RBKT  &none
    &none  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(Y)   &kp PIPE   &kp UNDER  &kp PLUS        &kp LBRC  &kp RBRC  &none
                               &none     &trans    &none       &kp BSPC   &kp DQT    &kp SQT
            >;
        };

        // Layer 5: 導航層
        nav_layer {
            label = "NAV";
            bindings = <
    &trans  &trans             &trans    &trans  &trans  &trans  &kp C_VOL_UP   &kp PG_UP &kp UP    &kp PG_DN &trans  &trans    
    &trans  &trans             &trans    &trans  &trans  &trans  &kp C_VOL_DN   &kp LEFT  &kp DOWN  &kp RIGHT &trans  &trans    
    &trans  &trans             &trans    &trans  &trans  &trans  &kp C_MUTE     &kp HOME  &trans    &kp END   &trans  &trans    
            &kp LS(LG(SPACE))  &mo TMUX  &trans  &trans  &trans  &trans  
            >;
        };

        // Layer 6: Mac 滑鼠與截圖層（已移除藍牙控制）
        mouse_layer {
            label = "MOUSE";
            bindings = <
    &none   &none         &none         &none         &none         &none           &none   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none   &none    
    &none   &none         &mkp LCLK     &mkp MCLK     &mkp RCLK     &none           &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none   &none    
    &none   &none         &none         &none         &none         &none           &none   &none           &mkp MCLK       &none            &none   &none    
                                        &kp LS(LG(N4)) &kp LS(LG(N3)) &trans        &trans  &trans          &trans  
            >;
        };

        // Layer 7: Windows 滑鼠與截圖層（已移除藍牙控制）
        win_mouse_layer {
            label = "WIN_MOUSE";
            bindings = <
    &none   &none         &none         &none         &none         &none           &none   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none   &none    
    &none   &none         &mkp LCLK     &mkp MCLK     &mkp RCLK     &none           &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none   &none    
    &none   &none         &none         &none         &none         &none           &none   &none           &mkp MCLK       &none            &none   &none    
                                        &kp LG(LS(S)) &kp PSCRN     &trans          &trans  &trans          &trans  
            >;
        };

        // Layer 8: Tmux 共用層
        tmux_layer {
            label = "TMUX";
            bindings = <
    &none  &tmux_cmd N1   &tmux_cmd N2   &tmux_cmd N3  &tmux_cmd N4   &tmux_cmd N5   &tmux_cmd N6  &tmux_cmd N7    &tmux_cmd UP    &tmux_cmd N9     &tmux_cmd N0   &none
    &none  &tmux_cmd DQT  &tmux_cmd PRCNT&none         &none          &none          &none         &tmux_cmd LEFT  &tmux_cmd DOWN  &tmux_cmd RIGHT  &none          &none
    &none  &tmux_cmd Z    &tmux_cmd X    &tmux_cmd C   &tmux_cmd LBKT &tmux_cmd RBKT &none         &tmux_cmd P     &none           &tmux_cmd N      &none          &none
                                         &trans        &trans         &trans         &trans        &trans          &trans
            >;
        };

        // Layer 9: 獨立系統/硬體管理層（同時按住左手 NUM + SYM 拇指鍵進入）
        sys_layer {
            label = "SYS";
            bindings = <
    &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
    &none   &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
    &none  &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
                                             &trans        &trans        &trans          &trans &trans &trans
            >;
        };
    };
};
